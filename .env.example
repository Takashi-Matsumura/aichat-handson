# docker-compose 用の環境変数ファイル
# このファイルを .env にコピーして使用してください
#
#   cp .env.example .env

# llama.cpp サーバーのURL（モデル1）
# ホストで動かしている場合は host.docker.internal を使用
LLAMA_API_URL=http://host.docker.internal:8080

# llama.cpp サーバーのURL（モデル2）
LLAMA_API_URL_2=http://host.docker.internal:8081

# 使用するモデル名
LLAMA_MODEL=gemma4

# モデルの表示ラベル（未設定時はモデル名から自動生成）
LLAMA_MODEL_LABEL_1=Gemma4
LLAMA_MODEL_LABEL_2=Gemma3

# 以下は既定値のままで動作する。チューニングする場合のみ設定する
# LLAMA_MAX_TOKENS=2048
# LLAMA_CLASSIFY_MAX_TOKENS=512

# --- RAG（社内資料を使った回答）の設定 ---
# 埋め込み専用に立てる3つ目のllama-serverのURL。ホストで動かしている場合は host.docker.internal を使用
RAG_EMBED_API_URL=http://host.docker.internal:8082
# 埋め込みAPIに渡すモデル名（llama-serverはこの値を厳密に検証しないことが多い）
RAG_EMBED_MODEL=embedding
# 以下は既定値のままで動作する。チューニングする場合のみ設定する
# RAG_KNOWLEDGE_DIR=./knowledge
# RAG_TOP_K=4
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=100
# RAG_MIN_SCORE=0.3
# RAG_EMBED_BATCH_SIZE=16
# RAG_EMBED_TIMEOUT_MS=20000
# RAG_EMBED_QUERY_PREFIX=
# RAG_EMBED_DOC_PREFIX=

# --- 利用統計 ---
# SQLiteファイルのパス（既定値のままで動作する。コンテナ内の docker-compose.yml のボリューム
# マウント先(./data)と合わせてあるため、変更する場合は volumes も合わせて変更すること）
# ANALYTICS_DB_PATH=./data/analytics.db
