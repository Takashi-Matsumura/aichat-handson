# llama.cpp サーバーのURL（デフォルト: http://localhost:8080）
LLAMA_API_URL=http://localhost:8080

# 使用するモデル名（デフォルト: gemma4）
LLAMA_MODEL=gemma4

# RAG用の埋め込みサーバーURL（デフォルト: http://localhost:8082）
RAG_EMBED_API_URL=http://localhost:8082

# 講師用管理画面(/presenter)のパスワード。未設定または12文字未満の場合、管理機能は無効になる
PRESENTER_PASSWORD=

# Web検索用 SearXNG のURL（docker compose up -d searxng で起動）。未設定ならWeb検索は無効
SEARXNG_URL=http://localhost:8888
